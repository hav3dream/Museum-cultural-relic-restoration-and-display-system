NODE_ENV=development
PORT=8888
JWT_SECRET=change-me-to-a-random-64-char-hex-string
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
DATABASE_URL=./data/museum.db
UPLOAD_DIR=./uploads

# 学术演示模式 (跳过积分检查)
ACADEMIC_MODE=true

# AI 模型服务地址 (内网部署)
# SGRGAN: 线稿引导的中国传统山水画修复 - POST /inpaint (image + mask -> PNG)
AI_SGRGAN_URL=http://127.0.0.1:5002
# DCADif: 中国传统壁画的解耦条件自适应扩散模型 - POST /generate (sketch_image + merged_image -> PNG)
AI_DCADIF_URL=http://127.0.0.1:5004
# Relic2Contour: 半监督壁画轮廓提取网络 - POST /sketchify (image -> PNG)
AI_RELIC2CONTOUR_URL=http://127.0.0.1:5001

# AI 调用超时与重试 (内网环境可适当调大)
AI_TIMEOUT_MS=300000
AI_MAX_RETRIES=2

# 数字人视频生成网关 (可选，未配置时数字人生成功能不可用)
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
